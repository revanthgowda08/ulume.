# Firebase (mobile app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Google Cloud APIs
EXPO_PUBLIC_GOOGLE_SPEECH_KEY=
EXPO_PUBLIC_GOOGLE_TTS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_GOOGLE_TRANSLATE_KEY=

# WhatsApp Business API
EXPO_PUBLIC_WHATSAPP_PHONE_ID=

# Cloud Functions only (set via `firebase functions:config:set` or functions/.env)
WHATSAPP_ACCESS_TOKEN=
MIXPANEL_TOKEN=

# Razorpay (Cloud Functions only — the key_secret must NEVER be added to the
# mobile app's env; only key_id is ever sent to the client, by the
# createRazorpayOrder callable). Get test-mode keys free, no KYC required,
# from the Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
