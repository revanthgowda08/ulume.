# Cloud Functions runtime config — copy to functions/.env and fill in.
# Never commit the real functions/.env (it's gitignored) and never add any
# of these to the mobile app's .env — these are server-only secrets/config.

# WhatsApp Business API (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# Razorpay (Dashboard > Settings > API Keys). key_secret must only ever live
# here — the createRazorpayOrder callable sends key_id to the client, never
# key_secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

MIXPANEL_TOKEN=
