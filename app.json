{
  "expo": {
    "name": "ULUME",
    "slug": "ulume",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3C34"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.ulume.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3C34"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "ULUME needs access to your photos to upload product images."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ULUME needs your location to show nearby sellers."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bee90a01-f432-4018-bcf3-871181125b55"
      }
    }
  }
}
